{
  "judul": "Sistem Pakar Identifikasi Kualitas dan Kesegaran Telur Ayam Mentah",
  "metode": "Forward Chaining",
  "deskripsi": "Sistem mengidentifikasi klasifikasi mutu fisik telur berdasarkan parameter yang dimasukkan pengguna. Hasil bukan penetapan keamanan mikrobiologis.",
  "fakta_input": {
    "cangkang": {
      "pertanyaan": "Bagaimana kondisi cangkang telur?",
      "tipe": "pilihan",
      "pilihan": [
        "utuh",
        "retak"
      ]
    },
    "putih_telur": {
      "pertanyaan": "Bagaimana kekentalan putih telur?",
      "tipe": "pilihan",
      "pilihan": [
        "kental",
        "sedikit_encer",
        "encer"
      ]
    },
    "kuning_telur_bentuk": {
      "pertanyaan": "Bagaimana bentuk kuning telur?",
      "tipe": "pilihan",
      "pilihan": [
        "bulat",
        "oval"
      ]
    },
    "kuning_telur_posisi": {
      "pertanyaan": "Bagaimana posisi kuning telur?",
      "tipe": "pilihan",
      "pilihan": [
        "tengah",
        "sedikit_bergeser",
        "pinggir"
      ]
    },
    "kantung_udara_cm": {
      "pertanyaan": "Berapa kedalaman kantung udara (cm)?",
      "tipe": "angka",
      "minimum": 0
    },
    "bau": {
      "pertanyaan": "Bagaimana bau telur?",
      "tipe": "pilihan",
      "pilihan": [
        "khas",
        "tidak_normal"
      ]
    }
  },
  "aturan": [
    {
      "id": "R1",
      "jika": [
        {
          "fakta": "cangkang",
          "operator": "=",
          "nilai": "utuh"
        },
        {
          "fakta": "putih_telur",
          "operator": "=",
          "nilai": "kental"
        },
        {
          "fakta": "kuning_telur_bentuk",
          "operator": "=",
          "nilai": "bulat"
        },
        {
          "fakta": "kuning_telur_posisi",
          "operator": "=",
          "nilai": "tengah"
        },
        {
          "fakta": "kantung_udara_cm",
          "operator": "<",
          "nilai": 0.5
        }
      ],
      "mode": "dan",
      "maka": "MUTU_I",
      "sumber": [
        "S1"
      ]
    },
    {
      "id": "R2",
      "jika": [
        {
          "fakta": "cangkang",
          "operator": "=",
          "nilai": "utuh"
        },
        {
          "fakta": "putih_telur",
          "operator": "=",
          "nilai": "sedikit_encer"
        },
        {
          "fakta": "kuning_telur_bentuk",
          "operator": "=",
          "nilai": "bulat"
        },
        {
          "fakta": "kuning_telur_posisi",
          "operator": "=",
          "nilai": "sedikit_bergeser"
        },
        {
          "fakta": "kantung_udara_cm",
          "operator": "rentang_inklusif",
          "nilai": [
            0.5,
            0.9
          ]
        }
      ],
      "mode": "dan",
      "maka": "MUTU_II",
      "sumber": [
        "S1"
      ]
    },
    {
      "id": "R3",
      "jika": [
        {
          "fakta": "cangkang",
          "operator": "=",
          "nilai": "utuh"
        },
        {
          "fakta": "putih_telur",
          "operator": "=",
          "nilai": "encer"
        },
        {
          "fakta": "kuning_telur_bentuk",
          "operator": "=",
          "nilai": "oval"
        },
        {
          "fakta": "kuning_telur_posisi",
          "operator": "=",
          "nilai": "pinggir"
        },
        {
          "fakta": "kantung_udara_cm",
          "operator": ">",
          "nilai": 0.9
        }
      ],
      "mode": "dan",
      "maka": "MUTU_III",
      "sumber": [
        "S1"
      ]
    },
    {
      "id": "R4",
      "jika": [
        {
          "fakta": "hasil",
          "operator": "ada",
          "nilai": "MUTU_I"
        },
        {
          "fakta": "bau",
          "operator": "=",
          "nilai": "khas"
        }
      ],
      "mode": "dan",
      "maka": "KUALITAS_FISIK_BAIK",
      "sumber": [
        "S1"
      ]
    },
    {
      "id": "R5",
      "jika": [
