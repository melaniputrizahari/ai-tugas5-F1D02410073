          "fakta": "hasil",
          "operator": "ada",
          "nilai": "MUTU_II"
        },
        {
          "fakta": "bau",
          "operator": "=",
          "nilai": "khas"
        }
      ],
      "mode": "dan",
      "maka": "KUALITAS_FISIK_CUKUP",
      "sumber": [
        "S1"
      ]
    },
    {
      "id": "R6",
      "jika": [
        {
          "fakta": "hasil",
          "operator": "ada",
          "nilai": "MUTU_III"
        },
        {
          "fakta": "bau",
          "operator": "=",
          "nilai": "khas"
        }
      ],
      "mode": "dan",
      "maka": "KUALITAS_FISIK_RENDAH",
      "sumber": [
        "S1"
      ]
    },
    {
      "id": "R7",
      "jika": [
        {
          "fakta": "cangkang",
          "operator": "=",
          "nilai": "retak"
        }
      ],
      "mode": "dan",
      "maka": "PERINGATAN_CANGKANG_RUSAK",
      "sumber": [
        "S1"
      ]
    },
    {
      "id": "R8",
      "jika": [
        {
          "fakta": "bau",
          "operator": "=",
          "nilai": "tidak_normal"
        }
      ],
      "mode": "dan",
      "maka": "INDIKASI_BAU_TIDAK_NORMAL",
      "sumber": [
        "S1"
      ]
    }
  ],
  "kesimpulan": {
    "MUTU_I": "Parameter yang diperiksa sesuai dengan kriteria mutu I.",
